---
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { pageContent } from '../lib/content';
import type {NewsStory} from '../lib/news';
import {archiveStories, newsPageSize} from '../lib/news-archive';
import '../styles/tailwind.css';

interface Props {
  page: number;
  importedEntries?: NewsStory[];
}

const {page, importedEntries} = Astro.props;
const archive = '/news-article/';
const pageUrl = (number: number) => number === 1 ? archive : archive + "page" + number + "/";
const route = pageUrl(page);
const content = await pageContent(archive).catch(() => null);
const previousHeading = content?.textBlocks?.find((block: {_key: string; text: string}) => block._key === 'text-0')?.text.trim();
const heading = previousHeading && previousHeading !== 'News & Article' ? previousHeading : 'News & stories';
const dateFormat = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'UTC' });

const ordered = importedEntries ?? await archiveStories();
const totalPages = Math.ceil(ordered.length / newsPageSize);
const entries = page > 0 ? ordered.slice((page - 1) * newsPageSize, page * newsPageSize) : [];
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="News and stories from Supertouch Kindness Foundation, covering disability inclusion, community work and announcements." />
    <title>{content?.title || heading}{page === 2 ? ' (Page 2)' : ''} | Supertouch Kindness Foundation</title>
    <link rel="stylesheet" href="/skf-design.css" />
    <script src="/skf-controls.js" defer is:inline></script>
  </head>
  <body class="news-page">
    <SiteHeader route={route} />
    <main id="content" tabindex="-1">
      <div class="news-banner">
        <div class="news-wrap">
          <nav aria-label="Breadcrumb" class="news-crumb">
            <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">News</span>
          </nav>
          <h1>{heading}</h1>
        </div>
      </div>
      <section class="news-wrap news-archive" id="stories" aria-labelledby="stories-title">
        <div class="news-intro">
          <h2 id="stories-title">{page === 1 ? 'Latest updates' : 'Earlier updates'}</h2>
          <p>Read stories from our communities, follow our disability inclusion work, and keep up with SKF announcements.</p>
        </div>
        <ul class="news-grid" role="list">
          {entries.map(({ path: href, image, alt, title, summary, publishedOn: date }) => (
            <li class="news-card">
              {image && <img class="news-photo" src={image} alt={alt ?? ""} loading="lazy" decoding="async" />}
              <div class="news-card-copy">
                <time datetime={date}>{dateFormat.format(new Date(date))}</time>
                <h3>{title}</h3>
                {summary && <p>{summary}</p>}
                <a class="news-button" href={href} aria-label={`Read story: ${title}`}>
                  Read story <span aria-hidden="true">→</span>
                </a>
              </div>
            </li>
          ))}
        </ul>
        {entries.length === 0 && <p>No stories were found on this page. <a href={archive}>Return to latest stories</a>.</p>}
        {entries.length > 0 && totalPages > 1 && (
          <nav class="news-pagination" aria-label="News archive pages">
            <span aria-current="page">Page {page} of {totalPages}</span>
            {page > 1 && <a class="news-button" rel="prev" href={pageUrl(page - 1)}>{page === 2 ? "Latest stories" : "Newer stories"} <span aria-hidden="true">←</span></a>}
            {page < totalPages && <a class="news-button" rel="next" href={pageUrl(page + 1)}>Older stories <span aria-hidden="true">→</span></a>}
          </nav>
        )}
      </section>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .news-page, .news-page :global(.skf-site-header), .news-page :global(.skf-site-footer) {
    font-family: Verdana, Geneva, sans-serif;
  }
  .news-wrap {
    width: min(100% - 2.5rem, 74rem);
    margin-inline: auto;
  }
  .news-banner {
    display: grid;
    align-items: end;
    min-block-size: clamp(16rem, 35vw, 28rem);
    padding-block: 3rem;
    color: white;
    background: linear-gradient(90deg, #082740 4%, #082740ee 28%, #08274066 78%), #082740 url('/wp-content/uploads/2024/10/DSC_3378-scaled.avif') center 42% / cover no-repeat;
    border-bottom: .4rem solid #2a82a8;
  }
  .news-banner h1 {
    max-width: 22ch;
    margin: .85rem 0 0;
    font-size: clamp(2.25rem, 6vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -.06em;
    line-height: 1.06;
    overflow-wrap: anywhere;
  }
  .news-crumb { display: flex; align-items: center; flex-wrap: wrap; gap: .7rem; font-size: .875rem; }
  .news-crumb a { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: underline; text-underline-offset: .25em; }
  .news-crumb a:hover { color: #b8e6ff; }
  .news-crumb a:focus-visible { outline: 2px solid white; outline-offset: 3px; }
  .news-archive { padding-block: clamp(2.5rem, 6vw, 5.5rem); }
  .news-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.75rem);
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #c8d9e6;
  }
  .news-intro h2 { margin: 0; color: #102b43; font-size: clamp(1.65rem, 4vw, 2.7rem); font-weight: 700; letter-spacing: -.045em; line-height: 1.15; }
  .news-intro p { max-width: 43ch; margin: 0; color: #3d5268; line-height: 1.65; }
  .news-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.35rem; padding: 0; margin: 0; list-style: none; }
  .news-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: .65rem;
    border: 1px solid #d6e2ea;
    border-radius: 1.15rem;
    background: #f4f8fb;
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }
  .news-card:focus-within { border-color: #2a82a8; }
  .news-photo { display: block; width: 100%; aspect-ratio: 8 / 5; object-fit: cover; border-radius: .75rem; background: #dae7ef; }
  .news-card-copy { display: flex; flex: 1; flex-direction: column; align-items: start; gap: .65rem; padding: 1rem .55rem .6rem; }
  .news-card time { color: #295b78; font-size: .875rem; font-weight: 700; }
  .news-card h3 { margin: 0 0 .45rem; color: #102b43; font-size: 1.1rem; font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
  .news-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .65rem;
    min-height: 2.75rem;
    margin-top: auto;
    padding: .55rem 1rem;
    border-radius: .5rem;
    background: #064b79;
    color: white;
    font-size: .9rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color .2s ease;
  }
  .news-button:hover, .news-button:focus-visible { background: #082740; color: white; text-decoration: underline; text-underline-offset: .2em; }
  .news-button:focus-visible { outline: 3px solid #064b79; outline-offset: 3px; }
  .news-pagination { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: .85rem 1.25rem; margin-top: 2rem; color: #3d5268; font-size: .9rem; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .news-card:hover { transform: translateY(-.2rem); border-color: #8cb2c8; box-shadow: 0 .7rem 1.5rem #08274017; }
  }
  @media (max-width: 62rem) {
    .news-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 39rem) {
    .news-grid { grid-template-columns: minmax(0, 1fr); }
    .news-wrap { width: calc(100% - 2rem); }
    .news-banner { background-position: 58% 42%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .news-card, .news-button { transition: none; }
  }
</style>
