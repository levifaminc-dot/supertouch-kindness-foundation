---
import type {Vacancy} from '../lib/content';
const {roles} = Astro.props as {roles: Vacancy[]};
const date = (value: string) => new Date(value).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Lagos',
});
---
<div class="vacancy-grid grid gap-6 lg:grid-cols-3">
  {roles.map((role) => (
    <article class="flex min-w-0 flex-col border border-skf-line bg-white p-6 md:p-7">
      <div class="mb-6 flex flex-col items-start gap-3">
        <span class="text-[10px] font-bold uppercase tracking-[0.12em] text-skf-blue">{role.department}</span>
        <span class="rounded border border-[#f0d999] bg-[#fff2d5] px-2 py-1 text-[11px] font-bold text-[#79520b]">
          {role.unpaid ? 'Unpaid internship' : 'Internship'}
        </span>
      </div>
      <h3 class="mb-3 text-[25px] font-bold text-skf-ink">{role.title}</h3>
      <p class="min-h-18 text-sm leading-6 text-skf-muted max-lg:min-h-0">{role.summary}</p>
      <details class="my-5 text-[13px] text-skf-ink">
        <summary class="cursor-pointer py-2 font-bold text-skf-blue">About this opportunity</summary>
        <div class="pt-2 leading-6">
          <h4 class="mb-1 font-bold">What you’ll support</h4>
          <ul class="mb-4 list-disc pl-5">{role.responsibilities.map((item) => <li>{item}</li>)}</ul>
          <h4 class="mb-1 font-bold">Helpful skills</h4>
          <p>{role.skills}</p>
        </div>
      </details>
      <ul class="mt-auto mb-6 space-y-2 border-t border-skf-line pt-5 text-xs text-skf-muted">
        <li class="flex justify-between gap-4"><span>Location</span><strong class="text-right font-semibold text-skf-ink">{role.location}</strong></li>
        <li class="flex justify-between gap-4"><span>Attendance</span><strong class="text-right font-semibold text-skf-ink">{role.attendance}</strong></li>
        <li class="flex justify-between gap-4"><span>Duration</span><strong class="text-right font-semibold text-skf-ink">{role.duration}</strong></li>
        <li class="flex justify-between gap-4"><span>Deadline</span><strong class="text-right font-semibold text-skf-ink">{date(role.deadline)}</strong></li>
      </ul>
      <a class="career-button self-start" href={'/career/apply/?role=' + encodeURIComponent(role.title)}>
        Apply for this role <span aria-hidden="true">↗</span>
      </a>
    </article>
  ))}
</div>
{!roles.length && <p>No internships are currently open. Please check back for future opportunities.</p>}
