---
const {route} = Astro.props as {route: string};
const links = [
  {label: 'About', href: '/about/'},
  {label: 'Our Team', href: '/our-team/'},
  {label: 'Our Work', href: '/our-work/'},
  {label: 'Impact', href: '/impact/'},
  {label: 'Reports', href: '/report/'},
  {label: 'News', href: '/news-article/'},
  {label: 'Careers', href: '/career/'},
  {label: 'Find support', href: '/contact/#find-support'},
];
const active = (href: string) => href === '/' ? route === '/' : route.startsWith(href.split('#')[0]);
---
<a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-4 focus:py-3 focus:text-skf-blue">Skip to main content</a>
<header class="skf-site-header z-30 bg-white text-skf-ink shadow-sm">
  <div class="skf-topbar bg-skf-blue px-4 py-2 text-xs text-white">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-1">
      <span class="skf-topbar-address">92, Opp. A.A Kime, Off Lagos Street, Maiduguri, Borno State</span>
      <div class="skf-topbar-links flex flex-wrap gap-x-5 gap-y-1">
        <a class="hover:underline focus-visible:underline" href="mailto:Info@supertouchkindnessfoundation.org"><span class="skf-contact-full">Info@supertouchkindnessfoundation.org</span><span class="skf-contact-short">Email SKF</span></a>
        <a class="hover:underline focus-visible:underline" href="tel:+2348169126501"><span class="skf-contact-full">+234 816 912 6501</span><span class="skf-contact-short">Call SKF</span></a>
      </div>
    </div>
  </div>
  <div class="skf-header-row mx-auto flex max-w-7xl items-center justify-between gap-2 px-3 py-2 lg:gap-4 lg:px-6">
    <a href="/" aria-label="Supertouch Kindness Foundation home" class="shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-skf-blue">
      <img src="/assets/205243a8f82d42fb8e97.png" alt="Supertouch Kindness Foundation" class="h-10 w-auto max-w-30 object-contain md:h-14 md:max-w-40" />
    </a>
    <nav aria-label="Primary navigation" class="skf-desktop-nav hidden items-center gap-1 lg:flex">
      {links.map(({label, href}) => <a href={href} aria-current={active(href) ? 'page' : undefined} class:list={['rounded px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-skf-blue', active(href) ? 'bg-skf-pale text-skf-blue' : 'text-skf-ink hover:bg-skf-pale hover:text-skf-blue']}>{label}</a>)}
    </nav>
    <a href="/donate/" class="skf-action skf-header-donate">Donate</a>
    <details class="skf-mobile-menu group relative lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded border border-skf-line min-h-11 px-2 py-2 text-sm font-bold text-skf-blue focus-visible:outline-2 focus-visible:outline-skf-blue">Menu</summary>
      <nav aria-label="Mobile navigation" class="skf-menu-panel absolute right-0 top-full z-40 mt-3 w-64 rounded border border-skf-line bg-white p-2 shadow-xl">
        {links.map(({label, href}) => <a href={href} aria-current={active(href) ? 'page' : undefined} class:list={['block rounded px-3 py-2 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-skf-blue', active(href) ? 'bg-skf-pale text-skf-blue' : 'text-skf-ink hover:bg-skf-pale']}>{label}</a>)}
      </nav>
    </details>
  </div>
</header>
