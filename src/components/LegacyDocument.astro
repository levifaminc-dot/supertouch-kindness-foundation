---
import '../styles/tailwind.css';

interface Props {
  htmlAttributes: Record<string, string>;
  bodyAttributes: Record<string, string>;
  head: string;
}

const {htmlAttributes, bodyAttributes, head} = Astro.props;
---
<!doctype html>
<html {...htmlAttributes}>
  <head><Fragment set:html={head} /></head>
  <body {...bodyAttributes}><slot /></body>
</html>
