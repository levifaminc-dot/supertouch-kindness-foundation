---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {pageContent} from '../lib/content';
import {impactFigures, impactProjects} from '../lib/editorial';
import '../styles/tailwind.css';

const route = '/impact/';
const [content, figures, allProjects] = await Promise.all([pageContent(route).catch(() => null), impactFigures(), impactProjects()]);
const blocks = new Map<string, string>(content?.textBlocks?.map((block: {_key: string; text: string}) => [block._key, block.text]) ?? []);
const copy = (key: string, fallback: string) => blocks.get(key)?.trim() || fallback;
const featured = allProjects.find(project => project.featured);
const projects = allProjects.filter(project => project !== featured);
Astro.response.headers.set('Cache-Control','private, no-store');
---
<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Explore SKF’s impact, disability inclusion projects and annual reports." />
  <title>Our Impact | Supertouch Kindness Foundation</title>
  <link rel="stylesheet" href="/skf-design.css" />
  <script src="/skf-controls.js" defer is:inline></script>
</head><body class="skf-impact-page">
  <SiteHeader route={route} />
  <main id="content" tabindex="-1">
    <section class="skf-impact-intro skf-editorial-impact-intro" aria-labelledby="impact-title">
      <div class="skf-home-section">
        <h1 id="impact-title">{copy('text-0','Our impact')}</h1>
        <p>{copy('text-2','SKF has reached 60,686+ people across Nigeria through direct and indirect programme activities.')}</p>
        <div class="skf-actions">
          <a class="skf-action" href="/report/#impact-reports">Browse impact reports</a>
          <a class="skf-action skf-action-outline" href="#impact-projects">Explore projects</a>
        </div>
      </div>
    </section>
    <section class="skf-home-section skf-figure-section" aria-labelledby="impact-figures">
      <div class="skf-figure-panel">
        <h2 id="impact-figures">Impact figures</h2>
        <dl class="skf-figure-grid">
          {figures.map(({value,suffix = '',label,period,source,sourceUrl}) => <div class="skf-figure-card">
            <dt>{label}</dt>
            <dd class="skf-figure-value">
              <span class="sr-only">{value.toLocaleString('en-GB')}{suffix}</span>
              <span aria-hidden="true"><span data-impact-count={value}>{value.toLocaleString('en-GB')}</span>{suffix}</span>
            </dd>
            {period && <dd class="skf-figure-source">{period}</dd>}
            {source && <dd class="skf-figure-source">{sourceUrl ? <a href={sourceUrl}>{source}</a> : source}</dd>}
          </div>)}
        </dl>
      </div>
    </section>
    {featured && <section class="skf-home-section skf-editorial-feature" aria-labelledby="impact-feature">
      <article class:list={["skf-impact-story", !featured.coverUrl && "skf-impact-story-no-image"]}>
        {featured.coverUrl && <img src={featured.coverUrl} width="1536" height="1152" loading="lazy" alt={featured.alt ?? ""} />}
        <div class="skf-story-copy">
          <p class="skf-kicker">Featured project · {featured.place}</p>
          <h2 id="impact-feature">{featured.title}</h2>
          {featured.description && <p>{featured.description}</p>}
          {featured.href && <a class="skf-action skf-action-outline" href={featured.href}>Read the project story</a>}
        </div>
      </article>
    </section>}
    <section class="skf-engagement" aria-labelledby="impact-projects">
      <div class="skf-home-section">
        <h2 id="impact-projects">{copy('text-6','Past projects')}</h2>
        <div class="skf-project-index">
          {projects.map(({year, place, title, href, description}) => <article>
            <p class="skf-kicker">{year && <>{year} · </>}{place}</p>
            <h3>{href ? <a class="skf-project-link" href={href}>{title}</a> : title}</h3>
            {description && <p>{description}</p>}
          </article>)}
        </div>
      </div>
    </section>
    <section class="skf-home-section" aria-labelledby="impact-support">
      <h2 id="impact-support">Support the work</h2>
      <p>Help fund community-led disability inclusion, health and protection programmes.</p>
      <a class="skf-action" href="/donate/">See how to give</a>
    </section>
  </main>
  <SiteFooter />
</body></html>

<style>
  .skf-figure-section { padding-block: clamp(2rem, 5vw, 4rem); }
  .skf-figure-panel {
    padding: clamp(1rem, 3.5vw, 3rem);
    border-radius: clamp(1rem, 3vw, 2rem);
    background: linear-gradient(125deg, #102e43 30%, #07548a);
    color: #fff;
  }
  .skf-figure-panel h2 {
    margin: 0 0 clamp(1rem, 3vw, 2rem);
    color: inherit;
    font-size: clamp(1.6rem, 3.5vw, 2.7rem);
    line-height: 1.15;
  }
  .skf-figure-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(.65rem, 2vw, 1.25rem);
    margin: 0;
  }
  .skf-figure-card {
    --figure-accent: #1481ac;
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: start;
    gap: .6rem;
    min-width: 0;
    margin: 0;
    padding: clamp(.95rem, 2.4vw, 2rem);
    border-top: .3rem solid var(--figure-accent);
    border-radius: .9rem;
    background: #fff;
    color: #102e43;
    box-shadow: 0 .55rem 1.4rem #061c2d33;
  }
  .skf-figure-card:nth-child(3n + 2) { --figure-accent: #328b80; }
  .skf-figure-card:nth-child(3n + 3) { --figure-accent: #b6812f; }
  .skf-figure-card dt {
    grid-row: 2;
    max-width: 26ch;
    font-weight: 700;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .skf-figure-value {
    grid-row: 1;
    margin: 0;
    color: #07548a;
    font-size: clamp(2rem, 4.45vw, 4.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -.055em;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .skf-figure-source {
    margin: 0;
    color: #3e5465;
    font-size: .875rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .skf-figure-source a { color: #07548a; text-decoration: underline; text-underline-offset: .2em; }
  .skf-figure-source a:hover { color: #102e43; text-decoration-thickness: .15em; }
  .skf-figure-source a:focus-visible { outline: 2px solid #07548a; outline-offset: 3px; }
  @media (max-width: 48rem) {
    .skf-figure-grid { grid-template-columns: 1fr; }
    .skf-figure-value { font-size: clamp(2.35rem, 8vw, 3.8rem); }
  }
  .skf-impact-story-no-image {grid-template-columns: 1fr;}
</style>
