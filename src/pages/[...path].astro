---
import {load} from 'cheerio';
import {pageContent,vacancies} from '../lib/content';
import Vacancies from '../components/Vacancies.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/tailwind.css';
const templates=import.meta.glob('../templates/*.html',{query:'?raw',import:'default',eager:true}) as Record<string,string>;
const route='/'+(Astro.params.path?Astro.params.path.replace(/\/$/,'')+'/':'');
const name=Astro.params.path?.replace(/\/$/,'').replaceAll('/','-')||'home';
const template=templates[`../templates/${name}.html`];
if(!template){Astro.response.status=404;}
const $=load(template||'<html><head><title>Page not found | SKF</title></head><body><main><h1>Page not found</h1><a href="/">Return home</a></main></body></html>');
let content=null;try{content=await pageContent(route);}catch{console.error('CMS content unavailable; using approved page copy.');}
if(content){if(content.title)$('title').text(content.title+' | Supertouch Kindness Foundation');for(const block of content.textBlocks||[]){if(/^text-\d+$/.test(block._key))$(`[data-cms-text="${block._key}"]`).text(block.text);}}
let roles:Awaited<ReturnType<typeof vacancies>>=[];
if(name==='career'||name==='career-apply'){
 try{roles=(await vacancies()).filter(r=>r.active&&Date.parse(r.deadline)>Date.now());}catch{console.error('Vacancies unavailable.');}
 if(name==='career'){
  $('.vacancy-grid').replaceWith('<!--ASTRO_VACANCIES-->');
  $('.career-status').text(roles.length+' open internships');
 }
 if(name==='career-apply'){
  $('#apply-role').empty().append('<option value="">Select an internship</option>');
  for(const r of roles)$('#apply-role').append($('<option>').attr('value',r.title).text(r.title));
  if(process.env.APPLICATIONS_ENABLED!=='true'||!roles.length){$('#application-submit').attr('disabled','disabled');$('#application-error').removeAttr('hidden').text('Online applications are being configured. Please check back shortly or contact SKF for assistance.');}
 }
}
// Keep the approved page content while replacing the duplicated WordPress
// chrome with reusable Astro components on every route.
$('.ekit-template-content-header').first().replaceWith('<!--ASTRO_HEADER-->');
$('.ekit-template-content-footer').first().replaceWith('<!--ASTRO_FOOTER-->');
const pageRoot=$('body').children('div,main').not('.ekit-template-content-header,.ekit-template-content-footer').first();
if(pageRoot.length){
 if(!pageRoot.attr('id'))pageRoot.attr('id','content');
 pageRoot.find('h1,h2,h3').addClass('text-balance');
 pageRoot.find('img').addClass('max-w-full');
 pageRoot.find('a,button,summary,input,select,textarea').addClass('focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-skf-blue');
}
Astro.response.headers.set('Cache-Control','private, no-store');
const pieces=$.html().split(/<!--ASTRO_(HEADER|VACANCIES|FOOTER)-->/);
---
{pieces.map(piece => piece==='HEADER' ? <SiteHeader route={route}/> : piece==='FOOTER' ? <SiteFooter/> : piece==='VACANCIES' ? <Vacancies roles={roles}/> : <Fragment set:html={piece}/>)}
