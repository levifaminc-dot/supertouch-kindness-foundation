---
import {load} from 'cheerio';
import {pageContent,vacancies} from '../lib/content';
import {vacancyApplicationUrl} from '../lib/vacancy-link';
import Vacancies from '../components/Vacancies.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DonorHero from '../components/DonorHero.astro';
import NewsStory from '../components/NewsStory.astro';
import {newsStory} from '../lib/news';
import seedContent from '../data/seed.json';
import LegacyDocument from '../components/LegacyDocument.astro';
const templates=import.meta.glob('../templates/*.html',{query:'?raw',import:'default',eager:true}) as Record<string,string>;
const route='/'+(Astro.params.path?Astro.params.path.replace(/\/$/,'')+'/':'');
const name=Astro.params.path?.replace(/\/$/,'').replaceAll('/','-')||'home';
if (name === 'career-apply') return Astro.redirect('/career/#opportunities', 302);
const template=templates[`../templates/${name}.html`];
const story = /^\/\d{4}\/\d{2}\/\d{2}\/[a-z0-9-]+\/$/.test(route) ? await newsStory(route).catch(() => null) : null;
if(!template && !story?.body?.length){Astro.response.status=404;}
const $=load(template||'<html><head><title>Page not found | SKF</title></head><body><main><h1>Page not found</h1><a href="/">Return home</a></main></body></html>');
if (story && template) {
  $("title").text(story.title + " | Supertouch Kindness Foundation");
  $("h1").first().text(story.title);
  if (story.summary) $("meta[name=description]").attr("content", story.summary);
}
let content=null;try{content=await pageContent(route);}catch{console.error('CMS content unavailable; using approved page copy.');}
if(content){if(content.title)$('title').text(content.title+' | Supertouch Kindness Foundation');for(const block of content.textBlocks||[]){if(/^text-\d+$/.test(block._key))$(`[data-cms-text="${block._key}"]`).text(block.text);}}
let roles:Awaited<ReturnType<typeof vacancies>>=[];
if (name === 'career') {
  try {
    roles = (await vacancies()).filter(role =>
      role.active && Date.parse(role.deadline) > Date.now() && vacancyApplicationUrl(role.applicationUrl),
    );
  } catch {
    console.error('Vacancies unavailable.');
  }
  $('.vacancy-grid').replaceWith('<!--ASTRO_VACANCIES-->');
  $('.career-status').text(roles.length === 1 ? '1 open position' : roles.length + ' open positions');
}
const oldFooter = $('.ekit-template-content-footer').first();
if (oldFooter.length) oldFooter.replaceWith('<!--ASTRO_FOOTER-->');
else $('body').append('<!--ASTRO_FOOTER-->');
const oldHeader = $('.ekit-template-content-header').first();
if (oldHeader.length) oldHeader.replaceWith('<!--ASTRO_HEADER-->');
else $('body').prepend('<!--ASTRO_HEADER-->');

$('head').append('<link rel="stylesheet" href="/skf-design.css"><script src="/skf-controls.js" defer></script>');
$('body').attr('data-skf-page', name);

const hero = $('[data-id="1d0b4e27"]');
const heroEyebrow = hero.find('[data-cms-text="text-0"]').text().trim() || 'Humanitarian aid and community development';
const heroSummary = hero.find('[data-cms-text="text-1"]').text().trim() || 'SKF works with persons with disabilities and local communities to improve access to health, protection and other essential services.';
const engagement = $('[data-id="74e5948b"]');
const homeSeed = seedContent.find((entry) => entry.route === '/');
const defaultActions = [
  'Explore the programmes improving access to health, protection and essential services.',
  'Share your skills and help build more inclusive communities.',
  'Support locally led work that advances disability rights across Nigeria.',
];
const actionDescriptions = defaultActions.map((fallback, index) => {
  const key = 'text-' + (index + 2);
  const current = engagement.find('[data-cms-text="' + key + '"]').text().trim();
  const initial = homeSeed?.textBlocks?.find((block) => block._key === key)?.text.trim();
  return current && current !== initial ? current : fallback;
});
if (name === 'home') {
  hero.replaceWith('<!--ASTRO_HERO-->');
  engagement.remove();
  $('[data-id="4a7a13e1"], [data-id="1546d717"]').remove();
}
else {
  const title = $('h1').first();
  const banner = title.closest('.elementor-top-section, .e-con.e-parent');
  if (banner.length) banner.addClass('skf-page-banner');
  else title.addClass('skf-page-title');
}

if (name === 'contact') {
  $('[data-id="8f323b8"]').replaceWith('<div class="skf-actions"><a class="skf-action" href="mailto:info@supertouchkindnessfoundation.org">Email SKF</a><a class="skf-action skf-action-outline" href="tel:+2348169126501">Call +234 816 912 6501</a></div>');
  $('iframe[src*="maps.google.com"]').attr('title', 'Map showing the SKF office in Maiduguri');

  const intro = $('<section class="skf-support" id="find-support" aria-labelledby="skf-support-title"><h2 id="skf-support-title">Find support or contact SKF</h2><p>Ask about disability inclusion, programme referrals, or accommodations for communicating with our team.</p><p><a href="mailto:info@supertouchkindnessfoundation.org">Email SKF</a> · <a href="tel:+2348169126501">Call +234 816 912 6501</a></p></section>');
  const contentHeading = $('h1').first().closest('.elementor-top-section, .e-con.e-parent');
  if (contentHeading.length) contentHeading.after(intro);
}
if (name === 'report') {
  $('h2').filter((_, heading) => $(heading).text().trim() === 'Impact Reports').first().attr('id','impact-reports');
}
if (name === 'donate') {
  $('[data-id="5a80d6e"]').remove();
  const details = $('[data-id="34723d9"] [data-cms-text="text-5"]').first();
  if (details.length) {
    const raw = details.clone();
    raw.find('br').replaceWith('\n');
    const text = raw.text();
    const fields = [...text.matchAll(/(Account Title|Account Name|Account Number|Number|Branch Code|Sort Code|Branch|Name of Bank):\s*([\s\S]*?)(?=\s*(?:Account Title|Account Name|Account Number|Number|Branch Code|Sort Code|Branch|Name of Bank):|$)/gi)];
    const panel = $('<section class="skf-support" aria-labelledby="skf-giving-title"><h2 id="skf-giving-title">Give by bank transfer</h2><p>Your gift supports disability inclusion, community protection and access to health services.</p></section>');
    const list = $('<dl></dl>');
    const actions = $('<div class="skf-actions"></div>');
    for (const [, label, rawValue] of fields) {
      const value = rawValue.trim();
      list.append($('<dt></dt>').text(label), $('<dd></dd>').text(value));
      const copyLabel = /account title|account name/i.test(label) ? 'Account name' : /^(account )?number$/i.test(label) ? 'Account number' : '';
      if (copyLabel && value) actions.append($('<button type="button" class="skf-action skf-action-outline"></button>').attr({'data-copy-value':value,'data-copy-label':copyLabel}).text('Copy ' + copyLabel.toLowerCase()));
    }
    if (fields.length) panel.append(list,actions,'<p class="skf-copy-status" role="status"></p>');
    else panel.append($('<div></div>').text(text));
    panel.append('<p><a href="/report/#impact-reports">See SKF’s impact reports</a> or <a href="mailto:info@supertouchkindnessfoundation.org?subject=Donation%20enquiry">email us about giving</a>.</p>');
    $('[data-id="4d7780a"]').replaceWith(panel);
  }
}

const pageRoot=$('body').children('div,main').not('.ekit-template-content-header,.ekit-template-content-footer').first();
if(pageRoot.length){
 pageRoot.attr({id:'content',tabindex:'-1'});
 if (!pageRoot.is('main')) pageRoot.attr('role','main');
 pageRoot.find('h1,h2,h3').addClass('text-balance');
 pageRoot.find('img').addClass('max-w-full');
 pageRoot.find('a,button,summary,input,select,textarea').addClass('focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-skf-blue');
}
Astro.response.headers.set('Cache-Control','private, no-store');
const htmlAttributes = $('html').attr() ?? {};
const bodyAttributes = $('body').attr() ?? {};
const head = $('head').html() ?? '';
const pieces = ($('body').html() ?? '').split(/<!--ASTRO_(HEADER|VACANCIES|FOOTER|HERO)-->/);
---
{story?.body?.length ? <NewsStory story={story} /> : <LegacyDocument {htmlAttributes} {bodyAttributes} {head}>
{pieces.map(piece => piece==='HEADER' ? <SiteHeader route={route}/> : piece==='FOOTER' ? <SiteFooter/> : piece==='VACANCIES' ? <Vacancies roles={roles}/> : piece==='HERO' ? <DonorHero eyebrow={heroEyebrow} summary={heroSummary} actionDescriptions={actionDescriptions}/> : <Fragment set:html={piece}/>)}
</LegacyDocument>}
