# Public content project identifiers (not secrets)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Optional read token for a private content dataset. Server only.
SANITY_READ_TOKEN=
# Used locally for initial import only. Never put in public variables.
SANITY_WRITE_TOKEN=
# Microsoft Entra app with selected access to the recruitment SharePoint site
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ID=
# At least 32 random characters; server only; keep stable across deployments
APPLICATION_SIGNING_SECRET=
# HR-only link to the selected SharePoint library
HR_SHAREPOINT_URL=
# Set true only after destination and upload tests pass
APPLICATIONS_ENABLED=false
# Protect all HTML/API routes until the owner authorizes public access.
# Prefer Vercel Deployment Protection. Additional app-level preview password:
PREVIEW_PASSWORD=
